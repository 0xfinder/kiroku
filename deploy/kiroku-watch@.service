[Unit]
Description=Kiroku Twitch capture for %i
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=finder
WorkingDirectory=/home/finder/kiroku
ExecStart=/home/finder/kiroku/.venv/bin/kiroku watch %i
Restart=on-failure
RestartSec=10
TimeoutStopSec=180
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
